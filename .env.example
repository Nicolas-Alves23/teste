# Copie este arquivo para .env antes de subir o projeto (obrigatório):
#   cp .env.example .env
# O docker-compose.yml não traz credenciais padrão — sem o .env, o `docker compose up`
# falha indicando qual variável está faltando.

# --- Banco de dados (container mysql) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=motores_db
MYSQL_USER=motores_user
MYSQL_PASSWORD=motores_pass

# --- Usados pela API para conectar no banco ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=motores_user
DB_PASSWORD=motores_pass
DB_NAME=motores_db

# --- API ---
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Front-end ---
FRONTEND_PORT=4200
