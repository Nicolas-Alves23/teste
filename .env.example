# Copie este arquivo para .env se quiser customizar os valores localmente.
# O projeto sobe com valores padrão (definidos no docker-compose.yml) mesmo sem esse arquivo.

# --- Banco de dados (container mysql) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=motores_db
MYSQL_USER=motores_user
MYSQL_PASSWORD=motores_pass

# --- Usados pela API para conectar no banco ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=motores_user
DB_PASSWORD=motores_pass
DB_NAME=motores_db

# --- API ---
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Front-end ---
FRONTEND_PORT=4200
